{
  "name": "sf-housing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Local-only apartment hunting scorer for San Francisco",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --env-file-if-exists=.env --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "sync": "node --env-file-if-exists=.env server/scripts/sync-crime.js",
    "zones": "node server/scripts/build-zones.js",
    "prestart": "vite build --logLevel warn",
    "start": "node --env-file-if-exists=.env server/index.js",
    "dry-run": "node --env-file-if-exists=.env server/scripts/dry-run-review.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/static": "^8.0.3",
    "better-sqlite3": "^11.7.0",
    "fastify": "^5.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.7"
  }
}
