# Copy this file to .env and fill in the key. .env is gitignored.
#
# Where the key comes from: console.anthropic.com, under Settings, API keys.
#
# This is NOT your Claude Pro or Max subscription. The Claude subscription and
# Anthropic API credits are separate products with separate billing: a
# subscription does not grant API access, and API calls draw on Console credits.
#
# Used for reading listing screenshots and writing the short note. Everything
# else in the tool runs without it.

ANTHROPIC_API_KEY=sk-ant-...

# Optional. Where your listings, pins, settings and the Zillow browser profile are kept.
# Point it outside this folder so updating the code never touches your data.
# Leave it out and `local/` inside this folder is used (git ignores it).
# SF_HOUSING_DATA=C:\Users\you\sf-housing-data
